# =============================================================================
# PR Gold — variáveis de ambiente
# =============================================================================
# Copie este arquivo para `.env.local` (NUNCA versionado) e preencha com os
# valores reais do painel do Supabase: Project Settings -> API.
#
# Enquanto estas variáveis estiverem vazias o site SOBE MESMO ASSIM, em modo de
# demonstração: o catálogo vem de `data/demo/` e o painel avisa em faixa
# amarela que nada do que for salvo persiste. Isso é proposital — permite
# revisar o site inteiro antes de existir banco.
# =============================================================================

# URL do projeto Supabase.
# Formato: https://SEU-PROJETO.supabase.co  (sem barra no final, sem /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=""

# Chave ANON (pública).
# Vai para o navegador — e tudo bem: a segurança dela depende 100% das
# políticas RLS do banco. Com a RLS deste projeto, ela só consegue ler o
# catálogo ativo e inserir uma solicitação de peça personalizada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# URL pública final do site. Usada em metadataBase, canonical, OG e sitemap.
# Sem isso, a prévia de link no WhatsApp sai sem imagem.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Chave SERVICE ROLE (SECRETA — IGNORA TODAS AS POLÍTICAS RLS).
#
#   NUNCA com prefixo NEXT_PUBLIC_. NUNCA no navegador. NUNCA em commit.
#
# DECISÃO EXPLÍCITA DESTE PROJETO:
#   Este projeto NÃO precisa da service role em produção.
#   O upload de imagens do painel usa uma política de Storage que permite
#   INSERT ao papel `authenticated` — ou seja, o upload roda com a sessão do
#   próprio administrador. A service role é usada SOMENTE por scripts locais
#   (`npm run seed`), e por isso deve ficar apenas no seu `.env.local`.
#
#   Não configure esta variável na Vercel.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=""

# =============================================================================
# Checklist antes de publicar:
# - [ ] .env.local preenchido e FORA do git (confira: git check-ignore .env.local)
# - [ ] NEXT_PUBLIC_* configuradas na Vercel em Production E Preview
# - [ ] NEXT_PUBLIC_SITE_URL apontando para o domínio final, com https
# - [ ] SUPABASE_SERVICE_ROLE_KEY ausente da Vercel (decisão acima)
# - [ ] RLS revisada tabela por tabela e testada com a anon key
# =============================================================================
